# syntax=docker/dockerfile:1

# Build Tailwind CSS before publishing the Blazor Server application.
ARG DOTNET_VERSION=8.0
FROM node:22-alpine AS css
WORKDIR /src
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund --loglevel=info
COPY Styles ./Styles
COPY Components ./Components
RUN npm run build:css

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION} AS build
WORKDIR /src
COPY . .
COPY --from=css /src/wwwroot/tailwind.css ./wwwroot/tailwind.css
RUN dotnet restore Playr.csproj
RUN dotnet publish Playr.csproj -c Release -o /app/publish --no-restore

# This container runs the C# pages, Blazor connection and recommendations API.
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION}
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080
COPY --from=build /app/publish .
USER $APP_UID
ENTRYPOINT ["dotnet", "Playr.dll"]
