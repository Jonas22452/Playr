# syntax=docker/dockerfile:1

# Publish once here too, so the frontend gets Blazor's generated CSS and assets.
ARG DOTNET_VERSION=8.0
FROM node:22-alpine AS css
WORKDIR /src
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund --loglevel=info
COPY Styles ./Styles
COPY Components ./Components
RUN npm run build:css

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION} AS build
WORKDIR /src
COPY . .
COPY --from=css /src/wwwroot/tailwind.css ./wwwroot/tailwind.css
RUN dotnet restore Playr.csproj
RUN dotnet publish Playr.csproj -c Release -o /app/publish --no-restore

# Nginx serves static files and forwards Blazor requests to the backend.
FROM nginx:stable-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/publish/wwwroot/ /usr/share/nginx/html/
EXPOSE 80
