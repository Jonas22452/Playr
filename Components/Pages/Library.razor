@page "/library"

<PageTitle>Playr - Library</PageTitle>

<div class="flex min-h-screen flex-col items-center justify-center bg-[#171719] px-6 text-center text-white">

    <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-3xl bg-[#292d37] text-[#9db8df]">
        <svg class="h-10 w-10"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="1.5"
             stroke-linecap="round"
             stroke-linejoin="round">
            <rect x="3" y="4" width="5" height="16" rx="1" />
            <rect x="10" y="4" width="5" height="16" rx="1" />
            <path d="m17 6 4 13" />
        </svg>
    </div>

    <h1 class="text-4xl font-bold tracking-tight">
        Your Library
    </h1>

    <p class="mt-4 max-w-md text-sm leading-7 text-[#9da4b1]">
        Your saved games and personal collections will appear here.
        This feature is coming soon.
    </p>

    <a href="/"
       class="mt-8 rounded-xl bg-[#7e9bc5] px-6 py-3 text-sm font-semibold !text-white !no-underline transition hover:bg-[#91b2e5]">
        Back to Home
    </a>

</div>
